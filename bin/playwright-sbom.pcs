from bisos import b
# from bisos.b import cmndsSeed
from bisos.b import cs
from bisos.b import b_io

# import collections

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
ap = pkgsSeed.aptPkg
pp = pkgsSeed.pipPkg

def playwrightInstall():
    outcome =  b.subProc.WOpW(invedBy=None, log=1).bash(
        f"""
playwright install
""")

aptPkgsList = [
    ap("libgtk-4-dev"),               #
    ap("libmanette-0.2-dev"),        #
]


pipPkgsList = [
    pp("playwright", ver=">=1.40.0"),
    pp("playwrightInstall", func=playwrightInstall),
]

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
    pipPkgsList=pipPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = """\
** Scope: Python interface to Playwright for automated web browser testing and automation.
   Playwright provides a high-level API for automating Chromium, Firefox, and WebKit browsers.
   Supports cross-browser testing, network interception, and visual comparisons.

        """
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )

def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*Command Examples*')
    if not (resStr := b.subProc.Op(outcome=cmndOutcome, log=0).bash(
       f"""which playwright""").stdout):
        pass
        # return(b_io.eh.badOutcome(cmndOutcome))

    literal(f"which playwright # {resStr.strip()}")
    literal("playwright --version")

    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Playwright Installation*')
    literal("pip install playwright")
    literal("playwright install  # Install browser binaries")
    literal("playwright install-deps  # Install system dependencies")

    cs.examples.menuChapter('*Basic Browser Automation*')
    literal("python -c \"from playwright.sync_api import sync_playwright; p = sync_playwright().start(); b = p.chromium.launch(); print('Browser launched')\"")
    literal("# Open a page and take screenshot")
    literal("python << 'EOF'\nfrom playwright.sync_api import sync_playwright\nwith sync_playwright() as p:\n    browser = p.chromium.launch()\n    page = browser.new_page()\n    page.goto('https://example.com')\n    page.screenshot(path='example.png')\n    browser.close()\nEOF")

    cs.examples.menuChapter('*Async Browser Automation*')
    literal("python << 'EOF'\nimport asyncio\nfrom playwright.async_api import async_playwright\nasync def main():\n    async with async_playwright() as p:\n        browser = await p.chromium.launch()\n        page = await browser.new_page()\n        await page.goto('https://example.com')\n        await page.screenshot(path='example.png')\n        await browser.close()\nasyncio.run(main())\nEOF")

    cs.examples.menuChapter('*Playwright Testing*')
    literal("pytest --headed  # Run tests with browser visible")
    literal("playwright codegen https://example.com  # Record user actions")

    cs.examples.menuChapter('*Playwright CLI Executables*')
    literal("playwright --version  # Check version")
    literal("playwright install  # Install browser binaries (Chromium, Firefox, WebKit)")
    literal("playwright install chromium  # Install specific browser")
    literal("playwright install-deps  # Install system dependencies for headless mode")
    literal("playwright open https://example.com  # Launch interactive browser")
    literal("playwright open https://example.com --browser firefox  # Open with Firefox")
    literal("playwright screenshot https://example.com output.png  # Capture screenshot")
    literal("playwright screenshot https://example.com output.png --full-page  # Full page screenshot")
    literal("playwright pdf https://example.com output.pdf  # Generate PDF from webpage")
    literal("playwright codegen https://example.com --output tests/test_example.py  # Record and generate test")

    cs.examples.menuChapter('*Browser Binary Locations*')
    literal("ls ~/.cache/ms-playwright/  # View installed browser binaries")
    literal("~/.cache/ms-playwright/chromium-*/chrome-linux/chrome  # Chromium location")
    literal("~/.cache/ms-playwright/firefox-*/firefox/firefox  # Firefox location")
    literal("~/.cache/ms-playwright/webkit-*/pw_run.sh  # WebKit location")

    cs.examples.menuChapter('*Debugging and Advanced Usage*')
    literal("PWDEBUG=1 pytest  # Run tests with inspector/debugger")
    literal("python -m playwright --help  # Run via Python module")
    literal("python -m playwright codegen https://example.com  # Codegen via Python module")
    literal("python -m playwright install  # Install via Python module")

    cs.examples.menuChapter('*End-Of Playwright Command Examples*')
    return cmndOutcome
